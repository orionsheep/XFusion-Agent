XFUSION_ENV=development
XFUSION_SECRET_KEY=change-me
XFUSION_DATABASE_URL=sqlite:///./backend/xfusion.db

# 格式: provider/model-id  示例见下方注释
XFUSION_MODEL=anthropic/claude-sonnet-4-6
XFUSION_CLAUDE_ENABLED=true
XFUSION_AGENT_SHARED_SECRET=change-me-agent-secret
XFUSION_DEFAULT_ADMIN_USERNAME=admin
XFUSION_DEFAULT_ADMIN_PASSWORD=admin123
XFUSION_METRIC_COLLECTION_INTERVAL_SECONDS=180

# ══════════════════════════════════════════════════════════
# Provider API Keys — 按需填写对应 provider 的 key
# ══════════════════════════════════════════════════════════

# ── Anthropic (anthropic/claude-sonnet-4-6) ────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (openai/gpt-4o) ────────────────────────────────
# OPENAI_API_KEY=

# ── Google Gemini (gemini/flash) ──────────────────────────
# GEMINI_API_KEY=

# ── 国内 providers ─────────────────────────────────────────
# 智谱 GLM        (zhipu/glm-4.7)
# ZHIPU_API_KEY=

# DeepSeek        (deepseek/v3 | deepseek/r1)
# DEEPSEEK_API_KEY=

# Moonshot/Kimi   (moonshot/kimi)
# MOONSHOT_API_KEY=

# 通义千问        (qwen/max | qwen/plus | qwen/turbo)
# DASHSCOPE_API_KEY=

# 豆包-字节跳动   (doubao/<endpoint-id>)
# DOUBAO_API_KEY=

# 硅基流动        (siliconflow/Qwen/Qwen2.5-72B-Instruct)
# SILICONFLOW_API_KEY=

# 零一万物 Yi     (yi/large | yi/medium)
# YI_API_KEY=

# MiniMax         (minimax/abab6)
# MINIMAX_API_KEY=

# 百川智能        (baichuan/turbo | baichuan/air)
# BAICHUAN_API_KEY=

# 腾讯混元        (hunyuan/pro | hunyuan/lite)
# HUNYUAN_API_KEY=

# 百度文心一言    (wenxin/4 | wenxin/turbo)
# WENXIN_API_KEY=
# WENXIN_SECRET_KEY=

# 讯飞星火        (spark/max | spark/pro | spark/lite)
# SPARK_API_KEY=

# ── 国际 OpenAI 兼容 providers ─────────────────────────────
# Mistral         (mistral/large | mistral/small)
# MISTRAL_API_KEY=

# Groq            (groq/llama3 | groq/mixtral)
# GROQ_API_KEY=

# Together AI     (together/meta-llama/Llama-3-70b-chat-hf)
# TOGETHER_API_KEY=

# OpenRouter      (openrouter/anthropic/claude-opus-4)
# OPENROUTER_API_KEY=

# Perplexity      (perplexity/sonar)
# PERPLEXITY_API_KEY=

# Cohere          (cohere/command)
# COHERE_API_KEY=

# ── 本地 ──────────────────────────────────────────────────
# Ollama          (ollama/llama3 | ollama/mistral)
# OLLAMA_BASE_URL=http://localhost:11434
