XFUSION_ENV=development
XFUSION_SECRET_KEY=change-me
XFUSION_DATABASE_URL=sqlite:///./backend/xfusion.db
# 格式: provider/model-id
# 支持: anthropic / zhipu / openai / gemini / ollama
XFUSION_MODEL=anthropic/claude-sonnet-4-6

# 对应 provider 的 API Key（按需填写）
ANTHROPIC_API_KEY=sk-ant-...
# ZHIPU_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
XFUSION_CLAUDE_ENABLED=true
XFUSION_AGENT_SHARED_SECRET=change-me-agent-secret
XFUSION_DEFAULT_ADMIN_USERNAME=admin
XFUSION_DEFAULT_ADMIN_PASSWORD=admin123
XFUSION_METRIC_COLLECTION_INTERVAL_SECONDS=180
