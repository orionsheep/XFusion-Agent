XFUSION_ENV=development
XFUSION_SECRET_KEY=change-me
XFUSION_DATABASE_URL=sqlite:///./backend/xfusion.db

# 主执行链
XFUSION_AGENT_MODE=claude_sdk_gateway
XFUSION_CLAUDE_ENABLED=true
XFUSION_CLAUDE_MODEL=MiniMax-M2.7
# 可选 alias: GLM-4.5

# Claude Agent SDK -> Anthropic-compatible gateway
XFUSION_GATEWAY_BASE_URL=http://127.0.0.1:4000
XFUSION_GATEWAY_AUTH_TOKEN=sk-local-litellm
XFUSION_GATEWAY_CUSTOM_MODEL_OPTION=MiniMax-M2.7
XFUSION_GATEWAY_CUSTOM_MODEL_OPTION_NAME=MiniMax-M2.7
XFUSION_GATEWAY_CUSTOM_MODEL_OPTION_DESCRIPTION=MiniMax-M2.7 routed through LiteLLM
XFUSION_GATEWAY_PROVIDER=minimax
XFUSION_GATEWAY_MODEL=MiniMax-M2.7
XFUSION_GATEWAY_TIMEOUT_SECONDS=45
# 切换到 GLM 时，将上面四项同时改成:
# XFUSION_CLAUDE_MODEL=GLM-4.5
# XFUSION_GATEWAY_CUSTOM_MODEL_OPTION=GLM-4.5
# XFUSION_GATEWAY_CUSTOM_MODEL_OPTION_NAME=GLM-4.5
# XFUSION_GATEWAY_PROVIDER=zhipu
# XFUSION_GATEWAY_MODEL=GLM-4.5

# 其他平台配置
XFUSION_AGENT_SHARED_SECRET=change-me-agent-secret
XFUSION_METRIC_COLLECTION_INTERVAL_SECONDS=180

# MiniMax 真实调用所需秘钥只放本地，不要提交到 GitHub
MINIMAX_API_KEY=

# LiteLLM 将使用 MiniMax 的 Anthropic-compatible 上游
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# LiteLLM 将使用 GLM 的 ZAI provider 上游
ZHIPU_API_KEY=
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
# 运行脚本会自动把 ZHIPU_* 映射成 LiteLLM 所需的 ZAI_*

# 仅保留为实验/对照，不再是主链
# XFUSION_MODEL=anthropic/claude-sonnet-4-6
